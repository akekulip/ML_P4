/* MVM-Lite on Tofino-1 (TNA). GENERATED by experiments/w8_prepare.py -- do not edit by hand.
 * Queries: Ethernet/IPv4/UDP(dst 50000)/mvm from Vision (dev port 9).
 * Per feature: fine table (key[31:12] exact, key[11:0] range) then coarse table (key[31:12] range)
 * write a thermometer code; leaf_tbl (ternary over the codes) holds the resident leaves, one entry
 * per leaf. Hit: answer reflected to Vision. Miss: forwarded to Hulk (dev port 10) for CPU
 * inference and digested to the controller. Hulk's replies are forwarded back to Vision.
 * Range keys are at most 20 bits per table (bf-p4c constraint class 2).
 */
#include <core.p4>
#include <tna.p4>

const bit<16> ETH_IPV4 = 0x0800;
const bit<8>  IP_UDP = 17;
const bit<16> MVM_PORT = 50000;

header ethernet_h { bit<48> dst; bit<48> src; bit<16> ether_type; }
header ipv4_h {
    bit<4> version; bit<4> ihl; bit<8> diffserv; bit<16> total_len; bit<16> identification;
    bit<3> flags; bit<13> frag_offset; bit<8> ttl; bit<8> protocol; bit<16> hdr_checksum;
    bit<32> src_addr; bit<32> dst_addr;
}
header udp_h { bit<16> src_port; bit<16> dst_port; bit<16> len; bit<16> checksum; }
header mvm_h {
    bit<32> qid;
    bit<8>  flags;      // bit0 = hit in switch, bit1 = answered by Hulk (CPU)
    bit<8>  klass;
    bit<16> leaf;
    bit<32> t_in;       // ingress MAC timestamp (low 32 bits, ns)
    bit<32> t_pipe;     // egress global timestamp - t_in (ns)
    bit<32> f0; bit<32> f1; bit<32> f2; bit<32> f3; bit<32> f4;
    bit<32> f5; bit<32> f6; bit<32> f7; bit<32> f8; bit<32> f9;
}

struct headers_t { ethernet_h eth; ipv4_h ipv4; udp_h udp; mvm_h mvm; }

struct digest_t {
    bit<32> qid;
    bit<32> f0; bit<32> f1; bit<32> f2; bit<32> f3; bit<32> f4;
    bit<32> f5; bit<32> f6; bit<32> f7; bit<32> f8; bit<32> f9;
}

struct ig_md_t {
    bit<100> code0;
    bit<42> code1;
    bit<32> code2;
    bit<2> code3;
    bit<22> code4;
    bit<25> code5;
    bit<63> code6;
    bit<62> code7;
    bit<2> code8;
    bit<11> code9;
}
struct eg_md_t { }

parser IgParser(packet_in pkt, out headers_t hdr, out ig_md_t md, out ingress_intrinsic_metadata_t ig_intr_md) {
    state start {
        pkt.extract(ig_intr_md);
        pkt.advance(PORT_METADATA_SIZE);
        transition parse_eth;
    }
    state parse_eth {
        pkt.extract(hdr.eth);
        transition select(hdr.eth.ether_type) { ETH_IPV4: parse_ipv4; default: accept; }
    }
    state parse_ipv4 {
        pkt.extract(hdr.ipv4);
        transition select(hdr.ipv4.protocol) { IP_UDP: parse_udp; default: accept; }
    }
    state parse_udp {
        pkt.extract(hdr.udp);
        transition select(hdr.udp.dst_port) { MVM_PORT: parse_mvm; default: accept; }
    }
    state parse_mvm {
        pkt.extract(hdr.mvm);
        transition accept;
    }
}

control Ingress(inout headers_t hdr, inout ig_md_t md,
                in ingress_intrinsic_metadata_t ig_intr_md,
                in ingress_intrinsic_metadata_from_parser_t ig_prsr_md,
                inout ingress_intrinsic_metadata_for_deparser_t ig_dprsr_md,
                inout ingress_intrinsic_metadata_for_tm_t ig_tm_md) {

    DirectCounter<bit<32>>(CounterType_t.PACKETS) leaf_ctr;

    action set_code0(bit<100> c) { md.code0 = c; }
    table fine0 {
        key = { hdr.mvm.f0[31:12] : exact @name("f0_hi"); hdr.mvm.f0[11:0] : range @name("f0_lo"); }
        actions = { set_code0; NoAction; }
        default_action = NoAction();
        size = 1024;
    }
    table coarse0 {
        key = { hdr.mvm.f0[31:12] : range @name("f0_hi"); }
        actions = { set_code0; NoAction; }
        default_action = NoAction();
        size = 512;
    }
    action set_code1(bit<42> c) { md.code1 = c; }
    table fine1 {
        key = { hdr.mvm.f1[31:12] : exact @name("f1_hi"); hdr.mvm.f1[11:0] : range @name("f1_lo"); }
        actions = { set_code1; NoAction; }
        default_action = NoAction();
        size = 512;
    }
    table coarse1 {
        key = { hdr.mvm.f1[31:12] : range @name("f1_hi"); }
        actions = { set_code1; NoAction; }
        default_action = NoAction();
        size = 256;
    }
    action set_code2(bit<32> c) { md.code2 = c; }
    table fine2 {
        key = { hdr.mvm.f2[31:12] : exact @name("f2_hi"); hdr.mvm.f2[11:0] : range @name("f2_lo"); }
        actions = { set_code2; NoAction; }
        default_action = NoAction();
        size = 256;
    }
    table coarse2 {
        key = { hdr.mvm.f2[31:12] : range @name("f2_hi"); }
        actions = { set_code2; NoAction; }
        default_action = NoAction();
        size = 256;
    }
    action set_code3(bit<2> c) { md.code3 = c; }
    table fine3 {
        key = { hdr.mvm.f3[31:12] : exact @name("f3_hi"); hdr.mvm.f3[11:0] : range @name("f3_lo"); }
        actions = { set_code3; NoAction; }
        default_action = NoAction();
        size = 64;
    }
    table coarse3 {
        key = { hdr.mvm.f3[31:12] : range @name("f3_hi"); }
        actions = { set_code3; NoAction; }
        default_action = NoAction();
        size = 64;
    }
    action set_code4(bit<22> c) { md.code4 = c; }
    table fine4 {
        key = { hdr.mvm.f4[31:12] : exact @name("f4_hi"); hdr.mvm.f4[11:0] : range @name("f4_lo"); }
        actions = { set_code4; NoAction; }
        default_action = NoAction();
        size = 256;
    }
    table coarse4 {
        key = { hdr.mvm.f4[31:12] : range @name("f4_hi"); }
        actions = { set_code4; NoAction; }
        default_action = NoAction();
        size = 128;
    }
    action set_code5(bit<25> c) { md.code5 = c; }
    table fine5 {
        key = { hdr.mvm.f5[31:12] : exact @name("f5_hi"); hdr.mvm.f5[11:0] : range @name("f5_lo"); }
        actions = { set_code5; NoAction; }
        default_action = NoAction();
        size = 256;
    }
    table coarse5 {
        key = { hdr.mvm.f5[31:12] : range @name("f5_hi"); }
        actions = { set_code5; NoAction; }
        default_action = NoAction();
        size = 128;
    }
    action set_code6(bit<63> c) { md.code6 = c; }
    table fine6 {
        key = { hdr.mvm.f6[31:12] : exact @name("f6_hi"); hdr.mvm.f6[11:0] : range @name("f6_lo"); }
        actions = { set_code6; NoAction; }
        default_action = NoAction();
        size = 512;
    }
    table coarse6 {
        key = { hdr.mvm.f6[31:12] : range @name("f6_hi"); }
        actions = { set_code6; NoAction; }
        default_action = NoAction();
        size = 256;
    }
    action set_code7(bit<62> c) { md.code7 = c; }
    table fine7 {
        key = { hdr.mvm.f7[31:12] : exact @name("f7_hi"); hdr.mvm.f7[11:0] : range @name("f7_lo"); }
        actions = { set_code7; NoAction; }
        default_action = NoAction();
        size = 512;
    }
    table coarse7 {
        key = { hdr.mvm.f7[31:12] : range @name("f7_hi"); }
        actions = { set_code7; NoAction; }
        default_action = NoAction();
        size = 256;
    }
    action set_code8(bit<2> c) { md.code8 = c; }
    table fine8 {
        key = { hdr.mvm.f8[31:12] : exact @name("f8_hi"); hdr.mvm.f8[11:0] : range @name("f8_lo"); }
        actions = { set_code8; NoAction; }
        default_action = NoAction();
        size = 64;
    }
    table coarse8 {
        key = { hdr.mvm.f8[31:12] : range @name("f8_hi"); }
        actions = { set_code8; NoAction; }
        default_action = NoAction();
        size = 64;
    }
    action set_code9(bit<11> c) { md.code9 = c; }
    table fine9 {
        key = { hdr.mvm.f9[31:12] : exact @name("f9_hi"); hdr.mvm.f9[11:0] : range @name("f9_lo"); }
        actions = { set_code9; NoAction; }
        default_action = NoAction();
        size = 128;
    }
    table coarse9 {
        key = { hdr.mvm.f9[31:12] : range @name("f9_hi"); }
        actions = { set_code9; NoAction; }
        default_action = NoAction();
        size = 64;
    }

    action leaf_hit(bit<16> leaf, bit<8> klass) {
        // reflect to the sender with swapped MACs: a NIC drops frames whose source MAC is its own
        bit<48> sender = hdr.eth.src;
        hdr.eth.src = hdr.eth.dst;
        hdr.eth.dst = sender;
        hdr.mvm.flags = 1;
        hdr.mvm.klass = klass;
        hdr.mvm.leaf = leaf;
        ig_tm_md.ucast_egress_port = 9;
        leaf_ctr.count();
    }
    action leaf_miss() {
        hdr.mvm.flags = 0;
        ig_tm_md.ucast_egress_port = 10;
        ig_dprsr_md.digest_type = 1;
        leaf_ctr.count();   // direct counters must run in every action of the table (bf-p4c rule)
    }
    table leaf_tbl {
        key = { md.code0 : ternary; md.code1 : ternary; md.code2 : ternary; md.code3 : ternary; md.code4 : ternary; md.code5 : ternary; md.code6 : ternary; md.code7 : ternary; md.code8 : ternary; md.code9 : ternary; }
        actions = { leaf_hit; leaf_miss; }
        default_action = leaf_miss();
        counters = leaf_ctr;
        size = 64;
    }

    action fwd(PortId_t port) { ig_tm_md.ucast_egress_port = port; }
    table port_fwd {
        key = { ig_intr_md.ingress_port : exact; }
        actions = { fwd; NoAction; }
        default_action = NoAction();
        size = 16;
    }

    apply {
        if (hdr.mvm.isValid() && ig_intr_md.ingress_port == 9) {
            hdr.mvm.t_in = ig_intr_md.ingress_mac_tstamp[31:0];
            if (!fine0.apply().hit) { coarse0.apply(); }
            if (!fine1.apply().hit) { coarse1.apply(); }
            if (!fine2.apply().hit) { coarse2.apply(); }
            if (!fine3.apply().hit) { coarse3.apply(); }
            if (!fine4.apply().hit) { coarse4.apply(); }
            if (!fine5.apply().hit) { coarse5.apply(); }
            if (!fine6.apply().hit) { coarse6.apply(); }
            if (!fine7.apply().hit) { coarse7.apply(); }
            if (!fine8.apply().hit) { coarse8.apply(); }
            if (!fine9.apply().hit) { coarse9.apply(); }
            leaf_tbl.apply();
        } else {
            port_fwd.apply();   // Hulk -> Vision replies and ordinary traffic between the two hosts
        }
    }
}

control IgDeparser(packet_out pkt, inout headers_t hdr, in ig_md_t md,
                   in ingress_intrinsic_metadata_for_deparser_t ig_dprsr_md) {
    Digest<digest_t>() miss_digest;
    apply {
        if (ig_dprsr_md.digest_type == 1) {
            miss_digest.pack({hdr.mvm.qid, hdr.mvm.f0, hdr.mvm.f1, hdr.mvm.f2, hdr.mvm.f3, hdr.mvm.f4,
                              hdr.mvm.f5, hdr.mvm.f6, hdr.mvm.f7, hdr.mvm.f8, hdr.mvm.f9});
        }
        pkt.emit(hdr);
    }
}

parser EgParser(packet_in pkt, out headers_t hdr, out eg_md_t md, out egress_intrinsic_metadata_t eg_intr_md) {
    state start {
        pkt.extract(eg_intr_md);
        transition parse_eth;
    }
    state parse_eth {
        pkt.extract(hdr.eth);
        transition select(hdr.eth.ether_type) { ETH_IPV4: parse_ipv4; default: accept; }
    }
    state parse_ipv4 {
        pkt.extract(hdr.ipv4);
        transition select(hdr.ipv4.protocol) { IP_UDP: parse_udp; default: accept; }
    }
    state parse_udp {
        pkt.extract(hdr.udp);
        transition select(hdr.udp.dst_port) { MVM_PORT: parse_mvm; default: accept; }
    }
    state parse_mvm {
        pkt.extract(hdr.mvm);
        transition accept;
    }
}

control Egress(inout headers_t hdr, inout eg_md_t md,
               in egress_intrinsic_metadata_t eg_intr_md,
               in egress_intrinsic_metadata_from_parser_t eg_prsr_md,
               inout egress_intrinsic_metadata_for_deparser_t eg_dprsr_md,
               inout egress_intrinsic_metadata_for_output_port_t eg_oport_md) {
    apply {
        if (hdr.mvm.isValid() && hdr.mvm.flags == 1) {
            hdr.mvm.t_pipe = eg_prsr_md.global_tstamp[31:0] - hdr.mvm.t_in;
        }
    }
}

control EgDeparser(packet_out pkt, inout headers_t hdr, in eg_md_t md,
                   in egress_intrinsic_metadata_for_deparser_t eg_dprsr_md) {
    apply { pkt.emit(hdr); }
}

Pipeline(IgParser(), Ingress(), IgDeparser(), EgParser(), Egress(), EgDeparser()) pipe;
Switch(pipe) main;
